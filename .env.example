# Copy this file to .env and fill in real values. NEVER commit .env.
# MongoDB Atlas connection string. The database name is selected by
# SPRING_DATA_MONGODB_DATABASE (default: smartlib).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# At least 32 random characters. The backend refuses to start without it.
JWT_SECRET=replace-with-at-least-32-random-characters

# Comma-separated browser origins allowed to call the API.
# Local Vite: http://localhost:5173 · Docker frontend: http://localhost:3000
# Production: your exact Vercel URL, e.g. https://smartlib.vercel.app
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000

# Demo data: automatic in the dev profile. In prod, true only for the first seed boot.
APP_SEED_DEMO=true

# Build-time URL used by the Docker/Vite frontend (include /api).
VITE_API_URL=http://localhost:8080/api

# Optional
APP_RATE_LIMIT_ENABLED=true
PORT=8080
